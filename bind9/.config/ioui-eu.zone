$TTL 1m
; -- https://bind9.readthedocs.io/en/stable/chapter3.html#setting-ttls

$ORIGIN ioui.eu.

@	IN	SOA	ns.ioui.eu. admin.ioui.eu. (
				2026053014     ; serial
				12h            ; refresh 12h
				15m            ; retry 15m
				1w             ; expire 3w
				1m )           ; minimum 2h

		IN	NS	ns.ioui.eu.
ns		IN	A	10.0.42.254

; -- Catch all
*			IN	A	10.0.42.23
o                       CNAME           o.ioui.eu.

; -- CNAME's for reverse proxy
xenon-rp	IN	A	10.0.42.23
opal-rp 	IN	A	10.0.42.225


; -- Devices
fritz7170	IN	A	10.0.42.11
xenon		IN	A	10.0.42.20
neon		IN	A	10.0.42.30
titanite	IN	A	10.0.42.100
opal		IN	A	10.0.42.224

; -- my DNS Records
bind		IN	A	10.0.42.26
allsky		IN	CNAME	neon
feed.adsb       IN      A       10.0.42.228

; -- new opal
vaultwarden	IN	CNAME	opal-rp
nextcloud	IN	CNAME	opal-rp
portainer	IN	CNAME	opal-rp
searx		IN	CNAME	opal-rp
rezepte         IN      CNAME   opal-rp
twitch          IN      CNAME   opal-rp
home            IN      CNAME   opal-rp
n8n             IN      CNAME   opal-rp
nc              IN      CNAME   opal-rp
adsb            IN      CNAME   opal-rp
*.adsb          IN      CNAME   opal-rp
grafana         IN      CNAME   opal-rp
influxdb        IN      CNAME   opal-rp
pgadmin         IN      CNAME   opal-rp

;address	IN	A	10.0.0.1 ; easy Load Balancing
;			IN	A	10.0.0.2
;			IN	A	10.0.0.3

@       60      IN      MX      10 mail
mail    60      IN      A       91.2.110.40
91.2.110.40		IN	PTR	mail
