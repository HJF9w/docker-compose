# Stack Configuration
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-nextcloud}
BASEPATH=${BASEPATH:-/data}
NEXTCLOUD_HOST=${NEXTCLOUD_HOST:-nc.example.com}
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-pw4postgres}
POSTGRES_USER=${POSTGRES_USER:-nextcloud}
POSTGRES_DB=${POSTGRES_DB:-nextcloud}
REDIS_HOST_PASSWORD=${REDIS_HOST_PASSWORD:-pw4redis}
NEXTCLOUD_ADMIN_USER=${NEXTCLOUD_ADMIN_USER:-admin}
NEXTCLOUD_ADMIN_PASSWORD=${NEXTCLOUD_ADMIN_PASSWORD:-pw4admin}
# Nextcloud Settings
NEXTCLOUD_TRUSTED_DOMAINS=${NEXTCLOUD_TRUSTED_DOMAINS:-${NEXTCLOUD_HOST} localhost 127.0.0.1 127.0.1.1}
TRUSTED_PROXIES=${TRUSTED_PROXIES:-172.16.0.0/12}
DEFAULT_PHONE_REGION=${DEFAULT_PHONE_REGION:-DE}
