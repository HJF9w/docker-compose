*.ioui.eu {
	tls {
		dns hetzner {env.HETZNER_DNS_TOKEN}
		resolvers 1.1.1.1 # use Hetzner NS if dns validation fails 193.47.99.5
                propagation_delay 30s
	}

        @portainer host portainer.ioui.eu
        handle @portainer {
                reverse_proxy system-app-1:9000
        }

        @vaultwarden host vaultwarden.ioui.eu
        handle @vaultwarden {
                reverse_proxy vaultwarden-app-1:80
        }
        
        @searx host searx.ioui.eu
        handle @searx {
                reverse_proxy searx-app-1:8080
        }

        @home host home.ioui.eu
        handle @home {
                reverse_proxy 10.0.42.123:8123
        }

        @rezepte host rezepte.ioui.eu
        handle @rezepte {
                reverse_proxy tandoor-app-1:80 ## !!! USE PORT 80, not 8080. Images won't load with 8080 !!! 
                header / {
                    header_up Host {host}
                    header_up X-Real-IP {remote_host}
                    header_up X-Forwarded-For {remote_host}
                    header_up X-Forwarded-Proto {scheme}
                }
        }

        @nextcloud host nextcloud.ioui.eu
        handle @nextcloud {
                reverse_proxy nextcloud-app-1:80
                redir /.well-known/carddav /remote.php/dav 301
                redir /.well-known/caldav /remote.php/dav 301
                redir /.well-known/webfinger /index.php/.well-known/webfinger 301
                redir /.well-known/nodeinfo /index.php/.well-known/nodeinfo 301
                header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                header / {
                    Strict-Transport-Security "max-age=15552000; includeSubDomains; preload"
                    X-XSS-Protection "1; mode=block"
                    X-Content-Type-Options "nosniff"
                    X-Frame-Options "DENY"
                    -Server
                    Cache-Control "no-store"
                    Pragma "no-cache"
                    X-Robots-Tag "noindex,nofollow"
                    X-Download-Options "noopen"
                    X-Permitted-Cross-Domain-Policies "none"
                    Referrer-Policy "no-referrer"
                }
        }

        @n8n host n8n.ioui.eu
        handle @n8n {
                reverse_proxy n8n-app-1:443
        }

        @twitch host twitch.ioui.eu
        handle @twitch {
                reverse_proxy video-player-app-1:3000
        }
        @nc host nc.ioui.eu
        handle @nc {
          reverse_proxy nc-app-1:80 {
              header_up Host {host}
              header_up X-Real-IP {remote_host}
              header_up X-Forwarded-For {remote_host}
              header_up X-Forwarded-Proto {scheme}
          }
          header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
          redir /.well-known/carddav /remote.php/dav 301
          redir /.well-known/caldav /remote.php/dav 301
          header Strict-Transport-Security "max-age=15552000;"
        }
}

*.adsb.ioui.eu {
	tls {
		dns hetzner {env.HETZNER_DNS_TOKEN}
		resolvers 1.1.1.1 # use Hetzner NS if dns validation fails 193.47.99.5
                propagation_delay 30s
	}
        @piaware host piaware.adsb.ioui.eu
        handle @piaware {
            reverse_proxy piaware:8080
        }
        @piaware-status host piaware-status.adsb.ioui.eu
        handle @piaware-status {
            reverse_proxy piaware-status:80
        }
        @planefinder host planefinder.adsb.ioui.eu
        handle @planefinder {
            reverse_proxy pfclient:30053
        }
        @planefence host planefence.adsb.ioui.eu
        handle @planefence {
            reverse_proxy planefence:80
        }
        @vrs host vrs.adsb.ioui.eu
        handle @vrs {
            reverse_proxy vrs:8080
        }
        @tar1090 host tar1090.adsb.ioui.eu
        handle @tar1090 {
            reverse_proxy adsb.ioui.eu:8080
        }
        @vnstat host vnstat.adsb.ioui.eu
        handle @vnstat {
            reverse_proxy vnstat:adsb.ioui.eu:8685
        }
}
