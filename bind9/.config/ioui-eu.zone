$TTL 12h
; https://bind9.readthedocs.io/en/stable/chapter3.html#setting-ttls

$ORIGIN ioui.eu.

@	IN	SOA	ns.ioui.eu. admin.ioui.eu. (
				2024062912     ; serial
				12h            ; refresh 12h
				15m            ; retry 15m
				1w             ; expire 3w
				2h )           ; minimum 2h

		IN	NS	ns.ioui.eu.
ns		IN	A	10.0.42.26

; -- Catch all
*		IN	A	10.0.42.23
hallo   IN  A   123.123.123.123