COMPOSE_PROJECT_NAME=tandoor
BASEPATH=/data

# ---------------------------------------------------------------------------
# This template contains only required options.
# Visit the docs to find more https://docs.tandoor.dev/system/configuration/
# ---------------------------------------------------------------------------

# random secret key, use for example `base64 /dev/urandom | head -c50` to generate one
SECRET_KEY=PdtxnB59XN5P92JLeWo9im400N+HeQmvNlylTIn1dgCugWqidR

# your default timezone See https://timezonedb.com/time-zones for a list of timezones
TZ=Europe/Brussels

# allowed hosts (see documentation), should be set to your hostname(s) but might be * (default) for some proxies/providers
ALLOWED_HOSTS=*

# add only a database password if you want to run with the default postgres, otherwise change settings accordingly
DB_ENGINE=django.db.backends.postgresql
POSTGRES_HOST=tandoor-db-1
POSTGRES_DB=tandoor
POSTGRES_PORT=5432
POSTGRES_USER=tandoor
POSTGRES_PASSWORD=bvka7zNMsCPhnGeq0X6tFEdTQjhx87GtInsQYUPqyNKmL406AfNMV5LInl3nKaZMQUYlk

EMAIL_HOST=${EMAIL_HOST}
EMAIL_PORT=587
EMAIL_HOST_USER=${EMAIL_USER}
EMAIL_HOST_PASSWORD=${EMAIL_PASS}
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=${EMAIL_FROM}
ACCOUNT_EMAIL_SUBJECT_PREFIX=Tandoor Rezepte
