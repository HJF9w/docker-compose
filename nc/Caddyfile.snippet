# Add this to your main Caddyfile
# Replace nc.example.com with your actual domain

nc.example.com {
    reverse_proxy nc-web-1:80 {
        # Caddy handles most headers automatically, but Nextcloud is picky
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Redirects for CalDAV/CardDAV
    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav /remote.php/dav 301
    
    # HSTS (Strict Transport Security)
    # Ensure you want this before uncommenting!
    # header Strict-Transport-Security "max-age=15552000;"
}
