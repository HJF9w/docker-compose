*.ioui.eu {
        tls {
                dns hetzner {env.HETZNER_DNS_TOKEN}
                resolvers 9.9.9.9 # use Hetzner NS if dns validation fails 193.47.99.5
                propagation_delay 30s
        }

        @bookstack    		host bookstack.ioui.eu
        @fritz    		host fritz.ioui.eu
        @fritz7170    		host fritz7170.ioui.eu
        @fritz7272    		host fritz7272.ioui.eu
        @git                    host git.ioui.eu
        @forgejo                host forgejo.ioui.eu
        @fritz7390    		host fritz7390.ioui.eu
        @grafana    		host grafana.ioui.eu
        @home    		host home.ioui.eu
        @influxdb    		host influxdb.ioui.eu
        @it-tools    		host it-tools.ioui.eu
        @kuma    		host kuma.ioui.eu
        @n8n    		host n8n.ioui.eu
        @nextcloud              host nextcloud.ioui.eu
        @pdf-tools    		host pdf-tools.ioui.eu
        @portainer    		host portainer.ioui.eu
        @portainer-neon         host portainer-neon.ioui.eu
        @portainer-xenon        host portainer-xenon.ioui.eu
        @rezepte                host rezepte.ioui.eu
        @searx    		host searx.ioui.eu
        @syncthing    		host syncthing.ioui.eu
        @twitch    		host twitch.ioui.eu
        @vaultwarden   		host vaultwarden.ioui.eu
        @vikunja                host vikunja.ioui.eu

        handle @bookstack     	{
		reverse_proxy bookstack-app-1:8080
	}
        handle @fritz     	{
		reverse_proxy 10.0.42.1:80
	}
        handle @fritz7170     	{
		reverse_proxy 10.0.42.11:80
	}
        handle @fritz7272     	{
		reverse_proxy 10.0.42.10:80
	}
        handle @git             {
		reverse_proxy forgejo-app-1:3000
	}
        handle @forgejo         {
		reverse_proxy forgejo-app-1:3000
	}
        handle @fritz7390     	{
		reverse_proxy 10.0.42.12:80
	}
        handle @grafana     	{
		reverse_proxy grafana-app-1:3000
	}
        handle @home     	{
		reverse_proxy 10.0.42.123:8123
	}
        handle @influxdb     	{
		reverse_proxy grafana-db-1:8086
	}
        handle @it-tools     	{
		reverse_proxy it-tools-app-1:8080
	}
        handle @kuma     	{
		reverse_proxy kuma-app-1:3001
	}
        handle @n8n     	{
		reverse_proxy n8n-app-1:443
	}
        handle @pdf-tools     	{
		reverse_proxy pdf-tools-app-1:8080
	}
        handle @portainer     	{
		reverse_proxy system-app-1:9000
	}
        handle @searx     	{
		reverse_proxy searx-app-1:8080
	}
        handle @syncthing     	{
		reverse_proxy syncthing-app-1:8384
	}
        handle @twitch     	{
		reverse_proxy video-player-app-1:3000
	}
        handle @vaultwarden    	{
		reverse_proxy vaultwarden-app-1:80
	}
        handle @vikunja {
		reverse_proxy vikunja-app-1:3456
	}

        handle @portainer-xenon {
                reverse_proxy system-app-1:9443 {
                      transport http {
                          tls
                          tls_insecure_skip_verify
                      }
                }
        }
        handle @portainer-neon {
                reverse_proxy 10.0.42.31:9443 {
                      transport http {
                          tls
                          tls_insecure_skip_verify
                      }
                }
        }
        handle @rezepte {
                reverse_proxy tandoor-app-1:80 ## !!! USE PORT 80, not 8080. Images won't load with 8080 !!! 
                header / {
                    header_up Host {host}
                    header_up X-Real-IP {remote_host}
                    header_up X-Forwarded-For {remote_host}
                    header_up X-Forwarded-Proto {scheme}
                }
        }
        handle @nextcloud {
                reverse_proxy nextcloud-app-1:80
                redir /.well-known/carddav /remote.php/dav 301
                redir /.well-known/caldav /remote.php/dav 301
                redir /.well-known/webfinger /index.php/.well-known/webfinger 301
                redir /.well-known/nodeinfo /index.php/.well-known/nodeinfo 301
                header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                header / {
                    Strict-Transport-Security "max-age=15552000; includeSubDomains; preload"
                    X-XSS-Protection "1; mode=block"
                    X-Content-Type-Options "nosniff"
                    X-Frame-Options "DENY"
                    -Server
                    Cache-Control "no-store"
                    Pragma "no-cache"
                    X-Robots-Tag "noindex,nofollow"
                    X-Download-Options "noopen"
                    X-Permitted-Cross-Domain-Policies "none"
                    Referrer-Policy "no-referrer"
                }
        }
}
