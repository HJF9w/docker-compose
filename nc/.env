# Stack Configuration
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-nc}
BASEPATH=${BASEPATH:-/data}
NEXTCLOUD_HOST=${NEXTCLOUD_HOST:-nc.example.com}

# Passwords (CHANGE THESE!)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-pw4postgres}
POSTGRES_USER=${POSTGRES_USER:-nextcloud}
POSTGRES_DB=${POSTGRES_DB:-nextcloud}
REDIS_HOST_PASSWORD=${REDIS_HOST_PASSWORD:-pw4redis}
NEXTCLOUD_ADMIN_USER=${NEXTCLOUD_ADMIN_USER:-admin}
NEXTCLOUD_ADMIN_PASSWORD=${NEXTCLOUD_ADMIN_PASSWORD:-pw4admin}

# Versions (Pinned for stability)
NEXTCLOUD_VERSION=${NEXTCLOUD_VERSION:-33.0.0-fpm-alpine}
POSTGRES_VERSION=${POSTGRES_VERSION:-17.9-alpine3.23}
REDIS_VERSION=${REDIS_VERSION:-8.6.1-alpine3.23}
NGINX_VERSION=${NGINX_VERSION:-1.29.5-alpine3.23}
IMAGINARY_VERSION=${IMAGINARY_VERSION:-20260218_123804}

# Nextcloud Settings
NEXTCLOUD_TRUSTED_DOMAINS=${NEXTCLOUD_TRUSTED_DOMAINS:-${NEXTCLOUD_HOST}}
# Trust the Caddy proxy (assuming it's in the system_internal network)
# You might need to adjust the CIDR if your docker network is different.
TRUSTED_PROXIES=${TRUSTED_PROXIES:-172.16.0.0/12}
DEFAULT_PHONE_REGION=${DEFAULT_PHONE_REGION:-DE}
