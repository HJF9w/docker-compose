# --------------------------------------------------
# BASE DIRECTORY SETTINGS
# --------------------------------------------------
BASEPATH=${BASEPATH:-/data}
COMPOSE_PROJECT_NAME=adsb
# --------------------------------------------------
# STATION DETAILS
# --------------------------------------------------
FEEDER_TZ=${FEEDER_TZ:-Europe/Brussels}
FEEDER_LAT=${FEEDER_LAT:-00.000000}
FEEDER_LONG=${FEEDER_LONG:-00.000000}
FEEDER_ALT_M=${FEEDER_ALT_M:-1}
FEEDER_ALT_FT=${FEEDER_ALT_FT:-1}
FEEDER_NAME=${FEEDER_NAME:-my_raspberry_pi_feeder}
# Generate a random UUIDv4 for this (e.g., from uuidgenerator.net)
ULTRAFEEDER_UUID=${ULTRAFEEDER_UUID:-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
# Optional: HeyWhatsThat Terrain Rings
FEEDER_HEYWHATSTHAT_ID=${FEEDER_HEYWHATSTHAT_ID:-xxxxxxxx}
FEEDER_HEYWHATSTHAT_ALTS=${FEEDER_HEYWHATSTHAT_ALTS:-3000,10000}
# --------------------------------------------------
# SDR DONGLE SETTINGS
# --------------------------------------------------
# Leave serial empty if you only have one SDR plugged in
ADSB_SDR_SERIAL=${ADSB_SDR_SERIAL:-}
ADSB_SDR_PPM=${ADSB_SDR_PPM:-0}
# --------------------------------------------------
# EXTERNAL INFLUXDB SETTINGS
# --------------------------------------------------
INFLUX_URL=${INFLUX_URL:-http://your-influxdb-ip:8086}
INFLUX_TOKEN=${INFLUX_TOKEN:-your_influx_api_token}
INFLUX_BUCKET=${INFLUX_BUCKET:-adsb_stats}
INFLUX_ORG=${INFLUX_ORG:-org}
# --------------------------------------------------
# COMMERCIAL FEEDER KEYS
# --------------------------------------------------
PIAWARE_FEEDER_ID=${PIAWARE_FEEDER_ID:-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
FR24_SHARING_KEY=${FR24_SHARING_KEY:-xxxxxxxxxxxxxxx}
AIRNAVRADAR_SHARING_KEY=${AIRNAVRADAR_SHARING_KEY:-xxxxxxxxxxxxxxxxxxxxxxxxxxx}
ADSBHUB_STATION_KEY=${ADSBHUB_STATION_KEY:-xxxxxxxxxxxxxxxxxx}
PLANEFINDER_SHARECODE=${PLANEFINDER_SHARECODE:-xxxxxxxxxxxxx}
PLANEWATCH_KEY=${PLANEWATCH_KEY:-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
RV_KEY=${RV_KEY:-xxxx:xxxxxxxxxxxxxxxxxxxxx}
# --------------------------------------------------
# VRS (Virtual Radar Server) SETTINGS
# --------------------------------------------------
VRS_ADMIN_USERNAME=${VRS_ADMIN_USERNAME:-admin}
VRS_ADMIN_PASSWORD=${VRS_ADMIN_PASSWORD:-pw4admin}
